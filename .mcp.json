{
  "mcpServers": {
    "meownopoly-automation": {
      "command": "node",
      "args": ["automation_mcp/index.js"],
      "env": {
        "MEOW_AUTOMATION_PORT": "7700"
      }
    },
    "meowtrack": {
      "type": "http",
      "url": "http://pattounecorp.ovh:7702/mcp",
      "headers": {
        "Authorization": "Bearer ${MEOWTRACK_TOKEN}"
      }
    }
  }
}
