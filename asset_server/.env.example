# Configuration du serveur de ressources Meownopoly
# Copier ce fichier en .env et remplir les valeurs

# Token d'authentification pour les uploads (obligatoire pour activer les uploads)
# Generer avec: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UPLOAD_TOKEN=

# Mode de deploiement (production desactive /api/files)
NODE_ENV=development
