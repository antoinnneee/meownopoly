# Server Configuration
PORT=3000

# Security & Limits
# Max payload size in bytes (e.g., 10MB = 10485760)
MAX_PAYLOAD_SIZE=10485760
# Max database size in bytes (e.g., 500MB = 524288000)
MAX_DB_SIZE=524288000

# Cleanup Settings
# Set to false to disable temporal cleanup (TTL)
ENABLE_TTL=false
# TTL in hours
TTL_HOURS=24

# Logging
# Set to true to enable detailed debug messages
DEBUG_MODE=true
